<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

    <Product Id="*" Name="LyraFlow" Language="1034" Version="1.1.7" Manufacturer="biglexj" UpgradeCode="55ee1e98-1bd5-4d89-990f-27756b85820c">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" SummaryCodepage="1252" Comments="LyraFlow — Dictado inteligente multiplataforma" />

        <MediaTemplate EmbedCab="yes" />

        <!-- 3-Click Setup Wizard with Spanish Dialogs -->
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
        <UIRef Id="WixUI_InstallDir" />

        <!-- Custom Installer Banners and Branding -->
        <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="APPLICATIONFOLDER" Name="LyraFlow">
                    <Directory Id="JPackageInstallDir" Name="." />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="LyraFlow"/>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <!-- Shortcuts -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="3c829e50-9ef2-4fa0-8a4b-f735f9927651">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="LyraFlow"
                          Description="LyraFlow — Dictado inteligente multiplataforma"
                          Target="[APPLICATIONFOLDER]LyraFlow.exe"
                          WorkingDirectory="APPLICATIONFOLDER"
                          Icon="LyraFlow.ico"/>
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\biglexj\LyraFlow" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="DesktopFolder">
            <Component Id="ApplicationShortcutDesktop" Guid="d83c2ba7-60a1-42db-9884-a4fe29a6b18a">
                <Shortcut Id="ApplicationDesktopShortcut"
                          Name="LyraFlow"
                          Description="LyraFlow — Dictado inteligente multiplataforma"
                          Target="[APPLICATIONFOLDER]LyraFlow.exe"
                          WorkingDirectory="APPLICATIONFOLDER"
                          Icon="LyraFlow.ico"/>
                <RegistryValue Root="HKCU" Key="Software\biglexj\LyraFlow" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <Icon Id="LyraFlow.ico" SourceFile="LyraFlow.ico"/>
        <Property Id="ARPPRODUCTICON" Value="LyraFlow.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/biglexj/LyraFlow" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/biglexj/LyraFlow" />
        <Property Id="ARPNOREPAIR" Value="1" />

        <Feature Id="MainFeature" Title="LyraFlow" Level="1">
            <ComponentGroupRef Id="Files" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="ApplicationShortcutDesktop" />
        </Feature>
    </Product>
</Wix>
